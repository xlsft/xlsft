# local development, copy to .env

# clarity cms
NUXT_PUBLIC_CLARITY_ENDPOINT=https://cv.xlsft.com/content
NUXT_CLARITY_TOKEN=

# github api for project readmes
NUXT_GITHUB_TOKEN=

# hcaptcha for the assistant chat
NUXT_HCAPTCHA_SECRET=

# assistant
NUXT_DEEPSEEK_TOKEN=

# requests from the chat go out by email, delivery is off while host or to is empty
# to: recipients as a json array ["a@example.com","b@example.com"] or comma-separated
NUXT_REQUESTS_EMAIL_HOST=smtp.beget.com
NUXT_REQUESTS_EMAIL_PORT=465
NUXT_REQUESTS_EMAIL_USER=
NUXT_REQUESTS_EMAIL_PASSWORD=
NUXT_REQUESTS_EMAIL_FROM=
NUXT_REQUESTS_EMAIL_TO=
