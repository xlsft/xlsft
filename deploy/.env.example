# cv.xlsft.com production environment, read by deploy/docker-compose.yaml; copy to deploy/.env

# app image tag in ghcr.io/xlsft/xlsft: latest, sha-<commit> or a release version
APP_TAG=latest

# app
NUXT_CLARITY_TOKEN=
NUXT_GITHUB_TOKEN=
NUXT_HCAPTCHA_SECRET=

# assistant
NUXT_DEEPSEEK_TOKEN=
# openssl rand -hex 32
NUXT_AI_SECRET=

# clarity (cv.xlsft.com/content)
CLARITY_ROOT_PASSWORD=
# openssl rand -hex 32
CLARITY_SESSION_SECRET=
# openssl rand -hex 32
POSTGRES_PASSWORD=

# s3 (beget) for clarity media
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# twenty crm (crm.xlsft.com)
# openssl rand -hex 32
TWENTY_DB_PASSWORD=
# openssl rand -base64 32, never lose it: secrets in the twenty database are encrypted with it
TWENTY_ENCRYPTION_KEY=
# Settings → APIs & Webhooks → Create API key, after the first sign-in
TWENTY_API_KEY=

# searxng
# openssl rand -hex 32
SEARXNG_SECRET=
