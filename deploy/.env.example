# cv.xlsft.com production environment, read by deploy/docker-compose.yaml; copy to deploy/.env

# app image tag in ghcr.io/xlsft/xlsft: latest, sha-<commit> or a release version
APP_TAG=latest

# app
NUXT_CLARITY_TOKEN=
NUXT_GITHUB_TOKEN=
NUXT_HCAPTCHA_SECRET=

# assistant
NUXT_DEEPSEEK_TOKEN=
# openssl rand -hex 32
NUXT_AI_SECRET=

# requests from the chat go out by email (smtp), delivery is off while host or to is empty
# to: recipients as a json array ["a@example.com","b@example.com"] or comma-separated
NUXT_REQUESTS_EMAIL_HOST=smtp.beget.com
NUXT_REQUESTS_EMAIL_PORT=465
NUXT_REQUESTS_EMAIL_USER=
NUXT_REQUESTS_EMAIL_PASSWORD=
NUXT_REQUESTS_EMAIL_FROM=
NUXT_REQUESTS_EMAIL_TO=

# clarity (cv.xlsft.com/content)
CLARITY_ROOT_PASSWORD=
# openssl rand -hex 32
CLARITY_SESSION_SECRET=
# openssl rand -hex 32
POSTGRES_PASSWORD=

# s3 (beget) for clarity media
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# searxng
# openssl rand -hex 32
SEARXNG_SECRET=
